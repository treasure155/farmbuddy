{
  "name": "farmbuddy",
  "private": true,
  "version": "1.0.7",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "icons": "tauri icon src-tauri/icons/app-icon.png",
    "setup-keys": "node tools/setup-keys.mjs",
    "license": "node tools/license-admin.mjs",
    "release": "node tools/release.mjs",
    "check-update": "node tools/check-update.mjs",
    "translation:check": "node tools/translation-check.mjs",
    "test": "npm run test:ui && npm run test:rust",
    "test:ui": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "content:check": "node tools/content-check.mjs",
    "content:sign": "node tools/sign-content.mjs",
    "seed:demo": "node tools/seed-demo-data.mjs"
  },
  "dependencies": {
    "@fontsource/courier-prime": "^5.2.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-barcode-scanner": "^2.5.3",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-legacy": "^6.1.1",
    "jsdom": "^25.0.1",
    "terser": "^5.51.2",
    "typescript": "~5.6.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.9"
  },
  "description": "FarmBuddy - offline agricultural management and advisory system by TechAlpha Hub"
}
